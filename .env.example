# Example Environment Variables for Property Unit Service
# Copy this file to .env and fill in the actual values

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=password

# JWT Security Configurations
# The public key of the API Gateway (used to verify incoming Gateway JWTs)
# Format should be a valid Base64 encoded RSA public key (PKCS8/X.509 without headers is common, or include headers if your JwtService parses them)
GATEWAY_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----

# The private key of THIS service (used to sign outgoing Service JWTs to other services)
SERVICE_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----

# (Optional) Override the default 5 minute expiration for outgoing Service JWTs
# SERVICE_JWT_EXPIRES_IN=5m
